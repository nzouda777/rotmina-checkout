# Tranzila Payment Gateway Configuration
# Copy this file to .env and fill in your actual values

# Required for hosted fields
TRANZILA_TERMINAL=fxprotmina
NEXT_PUBLIC_TRANZILA_TERMINAL=fxprotmina

# Test mode (true for development, false for production)
NEXT_PUBLIC_TRANZILA_TEST_MODE=true

# Required for production (optional for testing)
TRANZILA_TERMINAL_PASSWORD=your_terminal_password_here
TRANZILA_APP_KEY=your_app_key_here
TRANZILA_SECRET=your_secret_here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_URL=https://your-store-domain.com

# Shopify Configuration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_API_VERSION=2024-04

# Database
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (for order confirmations)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@yourstore.com

# Geoapify Address Autocomplete (shipping address suggestions in checkout).
# Free plan: 3,000 requests/day, no credit card required — sign up at
# myprojects.geoapify.com. Optional: if unset, the address field just falls
# back to a plain text input.
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key
